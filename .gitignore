# ── Node / build artifacts ─────────────────────────────────────────────
node_modules/
*.vsix
dist/

# ── Backups / temp / swap ──────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.swo
*.post-pivot.bak

# ── Python cache ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Logs (any *.log file + the logs/ folder) ───────────────────────────
*.log
logs/
debug.log

# ── Databases / generated state ────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ── Per-machine secrets / config ───────────────────────────────────────
config.ini
.claude/

# ── Per-machine browser-bridge profile data (1.74 GB QtWebEngine) ──────
data/
bridges/

# ── Per-machine runtime state ──────────────────────────────────────────
domains.txt
wake.txt
prompt_history.txt
prompts.txt
chats/
reports/

# ── Build / one-shot scratch artifacts ─────────────────────────────────
collision_report.json
assets/assets.zip
panel/.index_tmp.pdf
panel/index.png
MonkeyPatchDetector.txt
port.txt

# ── Lint / tooling output ──────────────────────────────────────────────
*.pylintjson

# ── Native build artifacts (C++ tray bridges) ──────────────────────────
bridges_cpp/obj/
bin/*.exe
bin/*.exe.manifest
*.pdb

# ── Theme dev / render comparison images (panel/themes/) ───────────────
# Generated by panel/themes/*/render_and_diff.py — not needed at runtime,
# only used during theme development to eyeball the screenshot diff.
panel/themes/**/*.png
panel/themes/**/*.pdf
