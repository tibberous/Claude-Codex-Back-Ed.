node_modules/
*.vsix
*.post-pivot.bak
collision_report.json
config.ini
debug.log
assets/assets.zip
__pycache__/
*.pyc
.claude/
panel/.index_tmp.pdf
panel/index.png
prompt_history.txt
prompts.txt
chats/

# Per-target chrome profiles spawned by CBE-Bridge-*.exe trays.
# Pure runtime state (cookies, cache, login session) — never source-of-truth.
# Bulky (hundreds of MB) and would leak sensitive session data.
data/minicomputer/
data/grok_profile/
data/chatgpt_profile/

# CBE's own runtime state — bridge session DBs (60-200MB each), traffic
# captures, model cache. Recreated on first run. GitHub rejects files
# over 100MB; even under that they bloat the repo for no benefit.
data/*.sqlite3
data/*.sqlite3-journal
data/*.sqlite3-wal
data/*.sqlite3-shm
data/traffic/
data/.session_cache/

# Build artifacts from build_bridges.ps1
bridges_cpp/obj/

# Volatile log dirs
logs/cdp/
logs/gpt-pilot/
logs/_test_upload.png

# Local diagnostic scratch
tools/_debug_*.py
.start.pylintjson
.app.pylintjson
tools/.*.pylintjson

# Built exes — rebuilt locally by build_bridges.ps1
bin/CBE-Bridge-*.exe

# Local-only docs
.github_release_*.md
build_full.log
port.txt
session.log
MonkeyPatchDetector.txt

# Generated-asset output dirs. Bridges that emit non-text outputs save
# here. Kept out of git because (a) media files are huge, and (b) they
# are user-generated work, not source. The dirs themselves are created
# on demand by the bridge_runner.
videos/
images/
audio/

# bridge_runner.load_bridge_from_archive extracts .bridge zips into
# sibling .unpacked_<name>/ dirs as a runtime cache. Pure artifact.
bridges/.unpacked_*/
