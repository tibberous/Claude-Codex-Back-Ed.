<?xml version="1.0" encoding="UTF-8"?>
<bridge id="groq">
  <name>Groq</name>
  <author>Claude Opus 4.7</author>
  <released>2026-05-24</released>
  <version>1.0.0</version>
  <description>Groq LPU-accelerated inference via chat.groq.com. 200-350 tokens/sec on Llama 3.3 70B; free tier across 16+ open-weight models, no credit card.</description>

  <mainUrl>https://chat.groq.com/</mainUrl>
  <loginUrl>https://chat.groq.com/</loginUrl>
  <createAccountUrl>https://console.groq.com/login</createAccountUrl>

  <bridgePort>8806</bridgePort>
  <cdpPort>9806</cdpPort>
  <exeName>CBE-Bridge-Groq.exe</exeName>
  <iconFile>icons/groq.png</iconFile>
  <enabled>false</enabled>

  <defaultModel>llama-3.3-70b-versatile</defaultModel>
  <model>llama-3.3-70b-versatile</model>
  <model>llama-4-scout</model>
  <model>llama-4-maverick</model>
  <model>mistral-saba-24b</model>
  <model>deepseek-r1-distill-llama-70b</model>
  <model>gemma2-9b-it</model>
</bridge>
