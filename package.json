{
  "name": "codex-black-ed",
  "displayName": "Claude Codex Black Ed.",
  "description": "Standalone Claude Codex Black panel. Opens its own webview and renders the Codex Black label.",
  "version": "1.0.0",
  "publisher": "TrentonTompkins",
  "author": {
    "name": "Trenton Tompkins",
    "email": "trenttompkins@gmail.com",
    "url": "https://www.trentontompkins.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexBlackEd.openPanel"
  ],
  "icon": "resources/icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexBlackEd.openPanel",
        "title": "Claude Codex Black: Open Panel"
      }
    ],
    "keybindings": [
      {
        "command": "codexBlackEd.openPanel",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      }
    ]
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "panel/**",
    "assets/label-alpha.png",
    "resources/icon.png"
  ]
}
