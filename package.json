{
  "name": "codex-black-ed",
  "displayName": "Claude Codex Black Ed.",
  "description": "Standalone Claude Codex Black panel with direct Anthropic API streaming.",
  "version": "1.0.0",
  "publisher": "TrentonTompkins",
  "author": {
    "name": "Trenton Tompkins",
    "email": "trenttompkins@gmail.com",
    "url": "https://www.trentontompkins.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "icon": "resources/icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexBlackEd.openPanel",
        "title": "Claude Codex Black: Open Panel",
        "icon": {
          "light": "assets/icon-light.png",
          "dark": "resources/icon-dark.png"
        }
      },
      {
        "command": "codexBlackEd.setApiKey",
        "title": "Claude Codex Black: Set API Key"
      },
      {
        "command": "codexBlackEd.clearApiKey",
        "title": "Claude Codex Black: Clear API Key"
      },
      {
        "command": "codexBlackEd.resetConversation",
        "title": "Claude Codex Black: Reset Conversation"
      },
      {
        "command": "codexBlackEd.showTrace",
        "title": "Claude Codex Black: Show Trace"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codexBlackEd.openPanel",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexBlackEd.openPanel",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      }
    ],
    "configuration": {
      "title": "Claude Codex Black",
      "properties": {
        "codexBlackEd.model": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "enum": [
            "claude-opus-4-7",
            "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001"
          ],
          "description": "Anthropic model to use for chat."
        },
        "codexBlackEd.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 16384,
          "description": "Max output tokens per response."
        }
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0"
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "config.ini",
    "panel/**",
    "lib/**",
    "assets/label-alpha.png",
    "resources/icon.png",
    "resources/icon-dark.png",
    "assets/icon-light.png",
    "resources/icon.svg",
    "node_modules/**"
  ]
}
