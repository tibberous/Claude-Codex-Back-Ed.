{
  "name": "codex-black-ed",
  "displayName": "Claude Codex Black Ed.",
  "description": "Standalone Claude Codex Black panel. Opens its own webview and renders the Codex Black label.",
  "version": "1.0.0",
  "publisher": "TrentonTompkins",
  "author": {
    "name": "Trenton Tompkins",
    "email": "trenttompkins@gmail.com",
    "url": "https://www.trentontompkins.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:codexBlackEd.openPanel"
  ],
  "icon": "resources/icon.png",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexBlackEd.openPanel",
        "title": "Claude Codex Black: Open Panel",
        "icon": {
          "light": "assets/icon-light.png",
          "dark": "resources/icon-dark.png"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "codexBlackEd.openPanel",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexBlackEd.openPanel",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      }
    ]
  },
  "files": [
    "extension.js",
    "package.json",
    "README.md",
    "panel/**",
    "assets/label-alpha.png",
    "resources/icon.png",
    "resources/icon-dark.png",
    "assets/icon-light.png",
    "resources/icon.svg"
  ]
}
