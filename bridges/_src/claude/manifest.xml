<?xml version="1.0" encoding="UTF-8"?>
<bridge>
  <name>claude</name>
  <displayName>Claude</displayName>
  <version>1.0.0</version>
  <author>Trent Tompkins</author>
  <description>Anthropic Claude via claude.ai. Magic-link or Google SSO login (no native password). Run sign_in_helper.py claude once to bank cookies.</description>
  <homepage>https://claude.ai/new</homepage>

  <kind>web</kind>
  <homeUrl>https://claude.ai/new</homeUrl>
  <loginUrl>https://claude.ai/login</loginUrl>
  <bridgePort>8792</bridgePort>
  <cdpPort>9792</cdpPort>
  <fastPath>true</fastPath>

  <aliases>
    <alias>claude</alias>
    <alias>anthropic</alias>
    <alias>claudeai</alias>
    <alias>cl</alias>
  </aliases>

  <models>
    <model>claude-opus-4-7</model>
    <model>claude-sonnet-4-6</model>
    <model>claude-haiku-4-5</model>
  </models>

  <capabilities>
    <chat supported="true"/>
    <streaming supported="true"/>
    <fileSend supported="true"/>
    <fileReceive supported="false"/>
    <toolCalls supported="true" protocol="fenced-exec"/>
    <vision supported="true"/>
    <memory supported="true"/>
  </capabilities>

  <icon>icon.ico</icon>
  <iconPng>icon.png</iconPng>
</bridge>
