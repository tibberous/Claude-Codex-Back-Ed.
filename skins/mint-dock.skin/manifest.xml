<?xml version="1.0" encoding="utf-8"?>
<skin>
  <id>mint-dock</id>
  <name>Mint Dock</name>
  <version>1.1</version>
  <author>Claude Opus 4.7</author>
  <accent>#86be43</accent>
  <stylesheet>styles.css</stylesheet>
  <description>Linux Mint Cinnamon dock. Real Mint green water-droplet wallpaper, glossy black 3D dock shelf at the bottom, and 22 hand-drawn Mint-flavored app tiles (terminal, folder, green Mint Menu, red power button, etc.) with dock-magnify hover.</description>
  <colors>
    <!-- Mint Cinnamon modal palette: dark green-tinted base, mint-green
         accents, light readable foreground. Echoes the dark Cinnamon
         panel + green Menu button aesthetic. -->
    <modal-bg>#1a2a14</modal-bg>
    <modal-fg>#eef6e6</modal-fg>
    <modal-border>#86be43</modal-border>
    <modal-title-bg-1>#4a8b1f</modal-title-bg-1>
    <modal-title-bg-2>#7dbb45</modal-title-bg-2>
    <modal-title-fg>#ffffff</modal-title-fg>
    <modal-foot-bg>#0e1a08</modal-foot-bg>
    <modal-accent>#86be43</modal-accent>
    <highlight-color>#c8e8a8</highlight-color>
    <!-- Code-block chrome: title bar above + footer below fenced code.
         Read by the panel as --cbe-code-bar-bg / --cbe-code-bar-fg.
         Deep Mint forest green, cohesive with the green accent. -->
    <code-bar-bg>#2c5a30</code-bar-bg>
    <code-bar-fg>#f2faf2</code-bar-fg>
  </colors>
  <panelHtml>index.html</panelHtml>
</skin>
