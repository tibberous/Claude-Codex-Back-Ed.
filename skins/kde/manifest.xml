<?xml version="1.0" encoding="utf-8"?>
<skin>
  <id>kde</id>
  <name>KDE Plasma</name>
  <version>1.0</version>
  <author>OpenAI ChatGPT</author>
  <accent>#3daee9</accent>
  <stylesheet>styles.css</stylesheet>
  <description>Frosted Plasma-style glass with cyan / violet halo.</description>
  <!-- Modal chrome. Pushed onto :root as --cbe-modal-* CSS variables at
       apply time so the panel's modals (Settings, Domains, Setup wizard,
       Handbook, Stored prompts, Help, Source viewer, right-click menu)
       paint in the theme's accent without duplicating modal markup. -->
  <colors>
    <modal-bg>#0f1825</modal-bg>
    <modal-fg>#eef7ff</modal-fg>
    <modal-border>#3daee9</modal-border>
    <modal-title-bg-1>#2a8bbb</modal-title-bg-1>
    <modal-title-bg-2>#3daee9</modal-title-bg-2>
    <modal-title-fg>#eef7ff</modal-title-fg>
    <modal-foot-bg>#0a1018</modal-foot-bg>
    <modal-accent>#3daee9</modal-accent>
    <!-- Universal high-contrast accent. Read by the panel as
         --cbe-highlight-color and used wherever a one-off attention
         element needs to pop on this skin (Auto Prompt countdown,
         focus rings, selection bars, etc). Picked per-skin to read
         clearly on the skin's modal-bg. -->
    <highlight-color>#ff8c42</highlight-color>
    <!-- Code-block chrome: title bar above + footer below fenced code.
         Read by the panel as --cbe-code-bar-bg / --cbe-code-bar-fg.
         Deep Plasma cyan. -->
    <code-bar-bg>#1c5f7e</code-bar-bg>
    <code-bar-fg>#eef7ff</code-bar-fg>
  </colors>
</skin>
