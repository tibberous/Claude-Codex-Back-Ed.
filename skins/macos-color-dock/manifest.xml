<?xml version="1.0" encoding="utf-8"?>
<skin>
  <id>macos-color-dock</id>
  <name>macOS Color Dock</name>
  <version>1.0</version>
  <author>Claude Opus 4.7</author>
  <accent>#007aff</accent>
  <stylesheet>styles.css</stylesheet>
  <description>macOS Big Sur dock — floating glass prompt pill above a translucent dock strip. Every tool button is a big full-color squircle app-tile (a unique vivid hue per icon) with a white glyph and a dock-magnify hover.</description>
  <colors>
    <modal-bg>#1e2230</modal-bg>
    <modal-fg>#eef1f8</modal-fg>
    <modal-border>#007aff</modal-border>
    <modal-title-bg-1>#0a84ff</modal-title-bg-1>
    <modal-title-bg-2>#5fb8ff</modal-title-bg-2>
    <modal-title-fg>#ffffff</modal-title-fg>
    <modal-foot-bg>#141824</modal-foot-bg>
    <modal-accent>#007aff</modal-accent>
    <highlight-color>#ffd166</highlight-color>
    <!-- Code-block chrome: title bar above + footer below fenced code.
         Read by the panel as --cbe-code-bar-bg / --cbe-code-bar-fg.
         Deep macOS system blue on white. -->
    <code-bar-bg>#0a4a8a</code-bar-bg>
    <code-bar-fg>#ffffff</code-bar-fg>
  </colors>
</skin>
