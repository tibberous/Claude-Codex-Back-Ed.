<?xml version="1.0" encoding="utf-8"?>
<skin>
  <id>terminal</id>
  <name>Terminal Hacker</name>
  <version>1.0</version>
  <author>OpenAI ChatGPT</author>
  <accent>#33ff82</accent>
  <stylesheet>styles.css</stylesheet>
  <description>Black + phosphor-green CRT with scanlines and glow.</description>
  <!-- Modal chrome. Pushed onto :root as --cbe-modal-* CSS variables at
       apply time so the panel's modals (Settings, Domains, Setup wizard,
       Handbook, Stored prompts, Help, Source viewer, right-click menu)
       paint in the theme's accent without duplicating modal markup. -->
  <colors>
    <modal-bg>#020704</modal-bg>
    <modal-fg>#7cffaa</modal-fg>
    <modal-border>#28c763</modal-border>
    <modal-title-bg-1>#0b2112</modal-title-bg-1>
    <modal-title-bg-2>#28c763</modal-title-bg-2>
    <modal-title-fg>#7cffaa</modal-title-fg>
    <modal-foot-bg>#010503</modal-foot-bg>
    <modal-accent>#33ff82</modal-accent>
  </colors>
</skin>
