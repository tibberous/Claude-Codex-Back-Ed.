<?xml version="1.0" encoding="utf-8"?>
<skin>
  <id>mint-dock</id>
  <name>Mint Dock</name>
  <version>1.0</version>
  <author>Claude Opus 4.7</author>
  <accent>#8fd694</accent>
  <stylesheet>styles.css</stylesheet>
  <description>Linux Mint-style glass dock. Floating prompt pill above a detached translucent dock strip; every tool button is a 96px glass tile with a real drop shadow and dock-magnify hover.</description>
  <colors>
    <modal-bg>#1c2a1d</modal-bg>
    <modal-fg>#e9f4ea</modal-fg>
    <modal-border>#8fd694</modal-border>
    <modal-title-bg-1>#3f7d44</modal-title-bg-1>
    <modal-title-bg-2>#5fa766</modal-title-bg-2>
    <modal-title-fg>#f2faf2</modal-title-fg>
    <modal-foot-bg>#152016</modal-foot-bg>
    <modal-accent>#7cc882</modal-accent>
    <highlight-color>#d6f5b3</highlight-color>
  </colors>
</skin>
